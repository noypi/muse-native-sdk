{
  "name": "@muse/cli",
  "version": "0.0.0",
  "scripts": {
    "test": "node --test test/*.test.js 2>/dev/null || test ! -d test",
    "test:packages": "node --test test/packages.test.js",
    "test:commands": "node --test test/commands.test.js",
    "test:config": "node --test test/print-config.test.js",
    "test:precedence": "node --test test/precedence.test.js",
    "test:schema": "node --test test/schema.test.js",
    "test:stages": "node --test test/stages.test.js",
    "test:help": "node --test test/help.test.js",
    "test:options": "node --test test/invalid-option.test.js",
    "test:buildlog": "node --test test/build-log.test.ts",
    "test:init": "node --test test/init.test.ts",
    "test:init-template": "node --test test/init-template.test.ts",
    "test:init-guard": "node --test test/init-guard.test.ts"
  },
  "bin": {
    "muse-native": "./bin/muse-native.js",
    "muse": "./bin/muse.js",
    "capo": "./bin/capo.js"
  }
}
